{
  "assertionGroups": [
    {
      "configs": [
        {
          "type": "httpStatusCode"
        },
        {
          "type": "httpHeaders"
        },
        {
          "type": "httpResponseCookies"
        },
        {
          "type": "httpResponseBody"
        },
        {
          "type": "httpResponseContentType"
        }
      ]
    }
  ],
  "cluster": {
    "cleanup": "inventory",
    "logLevel": "info",
    "logsCollected": true,
    "replayMode": "full-replay",
    "sidecar_tls_out": true
  },
  "generator": {
    "stages": [
      {
        "virtualUsers": {
          "requestDelay": {},
          "virtualUsers": "1"
        }
      }
    ]
  },
  "id": "playwright-gates-regression",
  "responder": {
    "numReplicas": 1,
    "passthrough_mode": true
  },
  "rules": [
    {
      "metricName": "browserJourneyPassPct",
      "type": "TOO_LOW",
      "value": 100,
      "action": "ALERT"
    }
  ]
}
