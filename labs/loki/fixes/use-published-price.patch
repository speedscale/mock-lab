+func TestRepricingCallBudget(t *testing.T) {
+	cases := []struct {
+		name      string
+		responses []priceResponse
+		status    int
+		calls     int32
+	}{
+		{
+			name: "published price is usable immediately",
+			responses: []priceResponse{{SKU: "SSC-7300", Currency: "USD", State: stateRepricing,
+				LastSettledPriceCents: 12999, RepricingWindowMS: 900000}},
+			status: http.StatusOK, calls: 1,
+		},
+		{
+			name: "missing price retries until settled",
+			responses: []priceResponse{
+				{SKU: "SSC-7300", Currency: "USD", State: stateRepricing},
+				{SKU: "SSC-7300", Currency: "USD", State: stateRepricing},
+				{SKU: "SSC-7300", Currency: "USD", State: stateSettled, UnitPriceCents: 12999},
+			},
+			status: http.StatusOK, calls: 3,
+		},
+		{
+			name:      "missing price exhausts retries",
+			responses: []priceResponse{{SKU: "SSC-7300", Currency: "USD", State: stateRepricing}},
+			status:    http.StatusBadGateway, calls: 4,
+		},
+		{
+			name: "negative price exhausts retries",
+			responses: []priceResponse{{SKU: "SSC-7300", Currency: "USD", State: stateRepricing,
+				LastSettledPriceCents: -1}},
+			status: http.StatusBadGateway, calls: 4,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var calls atomic.Int32
+			service := newTestService(t, func(w http.ResponseWriter, _ *http.Request) {
+				index := min(int(calls.Add(1))-1, len(tc.responses)-1)
+				_ = json.NewEncoder(w).Encode(tc.responses[index])
+			})
+			recorder := httptest.NewRecorder()
+			service.Handler()(recorder, httptest.NewRequest(http.MethodGet, "/api/quote?sku=SSC-7300&qty=2", nil))
+			if recorder.Code != tc.status {
+				t.Fatalf("status = %d, want %d", recorder.Code, tc.status)
+			}
+			if calls.Load() != tc.calls {
+				t.Errorf("pricing calls = %d, want %d", calls.Load(), tc.calls)
+			}
+			if tc.status == http.StatusOK {
+				quote := decodeQuote(t, recorder)
+				if quote.UnitPriceCents != 12999 || quote.TotalCents != 25998 || quote.Currency != "USD" {
+					t.Fatalf("unexpected quote %+v", quote)
+				}
+			}
+		})
+	}
+}
