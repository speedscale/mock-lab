+package main
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestSummarizeProjects(t *testing.T) {
+	got := summarizeProjects([]project{{Lifecycle: "Graduated"}, {Lifecycle: "Graduated"}, {Lifecycle: "Sandbox"}})
+	want := projectStats{Total: 3, ByMaturity: map[string]int{"Graduated": 2, "Sandbox": 1}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("summarizeProjects() = %#v, want %#v", got, want)
+	}
+}
