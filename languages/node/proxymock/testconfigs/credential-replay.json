{
  "id": "credential-replay",
  "version": 3,
  "rules": [
    {
      "metricName": "passAssertPct",
      "type": "TOO_LOW",
      "value": 100,
      "action": "ALERT"
    }
  ],
  "assertionGroups": [
    {
      "configs": [
        {
          "type": "httpStatusCode"
        },
        {
          "type": "httpResponseBody",
          "config": {
            "ignore": "access_token"
          }
        },
        {
          "type": "httpResponseSchema"
        }
      ]
    }
  ],
  "generator": {
    "stages": [
      {
        "virtualUsers": {
          "virtualUsers": "1",
          "requestDelay": {}
        }
      }
    ]
  }
}
