+
+func TestStatsHandlerDecodesRecordedMaturityField(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/projects" {
+			t.Errorf("downstream path = %q, want /v1/projects", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`[
+			{"id":"kubernetes","maturity":"Graduated"},
+			{"id":"prometheus","maturity":"Graduated"},
+			{"id":"k3s","maturity":"Sandbox"}
+		]`))
+	}))
+	defer server.Close()
+
+	previousDownstream := downstream
+	downstream = server.URL
+	t.Cleanup(func() { downstream = previousDownstream })
+	response := httptest.NewRecorder()
+	statsHandler(response, httptest.NewRequest(http.MethodGet, "/api/stats", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d: %s", response.Code, http.StatusOK, response.Body.String())
+	}
+	var got projectStats
+	if err := json.Unmarshal(response.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := projectStats{Total: 3, ByMaturity: map[string]int{"Graduated": 2, "Sandbox": 1}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("statsHandler() = %#v, want %#v", got, want)
+	}
+}
