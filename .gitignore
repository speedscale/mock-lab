# generated static export (rendered from lab/server/data, synced to S3)
/lab/static/
# scratch proxymock recordings from `proxymock record` in a language dir --
# the committed per-language recording/ is the exception, everything else
# (recorded-*, mocked-*, replayed-*, results/, .replay/) stays ignored
/languages/go/proxymock/*
!/languages/go/proxymock/recording/
/languages/node/proxymock/*
!/languages/node/proxymock/recording/
/languages/python/proxymock/*
!/languages/python/proxymock/recording/
/languages/java/proxymock/*
!/languages/java/proxymock/recording/
/languages/ruby/proxymock/*
!/languages/ruby/proxymock/recording/
/languages/dotnet/proxymock/*
!/languages/dotnet/proxymock/recording/
/languages/cpp/proxymock/*
!/languages/cpp/proxymock/recording/
# scratch proxymock writes inside the committed per-language recordings
/languages/*/proxymock/recording/.replay/
/languages/*/proxymock/recording/*/.replay/
# scratch proxymock writes into the committed shared workspace (lab/proxymock/)
/lab/proxymock/results/
/lab/proxymock/recording/.replay/
/lab/proxymock/recording/localhost/.replay/
# companion labs under labs/ -- per-lab scratch proxymock output and binaries
/labs/pyroscope/proxymock/recording/
/labs/pyroscope/proxymock/results/
/labs/pyroscope/bin/
/labs/pyroscope/.run/
/labs/pyroscope/proxymock.log
/labs/tempo/proxymock/recording/
/labs/tempo/proxymock/results/
/labs/tempo/bin/
/labs/tempo/.run/
/labs/tempo/proxymock.log
/labs/obi/bin/
/labs/obi/proxymock/
/labs/obi/proxymock.log
/labs/prometheus/proxymock/
/labs/prometheus/bin/
/labs/prometheus/proxymock.log
# python bytecode
__pycache__/
# build artifacts
/mock-lab
*.test
*.out
/languages/dotnet/bin/
/languages/dotnet/obj/
node_modules/
/languages/go/go
/lab/server/server
/languages/cpp/app

.claude/worktrees
