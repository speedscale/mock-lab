# generated static export (rendered from shared/server/data, synced to S3)
/shared/static/
# scratch proxymock recordings from `proxymock record` in a language dir --
# committed recordings and workspace documents are exceptions; everything else
# (recorded-*, mocked-*, replayed-*, results/, .replay/) stays ignored
/languages/go/proxymock/*
!/languages/go/proxymock/recording/
!/languages/go/proxymock/applications/
!/languages/go/proxymock/blueprints/
!/languages/go/proxymock/testconfigs/
/languages/node/proxymock/*
!/languages/node/proxymock/recording/
!/languages/node/proxymock/applications/
!/languages/node/proxymock/blueprints/
!/languages/node/proxymock/testconfigs/
/languages/python/proxymock/*
!/languages/python/proxymock/recording/
!/languages/python/proxymock/applications/
!/languages/python/proxymock/blueprints/
!/languages/python/proxymock/testconfigs/
