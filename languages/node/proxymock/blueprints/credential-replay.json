{
  "id": "e9e38e8f-893b-427c-af3b-b7364d7d49bc",
  "name": "credential-replay",
  "description": "Re-sign captured demo JWTs using the public fixture key; the existing smart-replace blueprint refreshes opaque bearer tokens.",
  "services": [
    "localhost"
  ],
  "tokenizeConfig": {
    "name": "credential-replay",
    "id": "e9e38e8f-893b-427c-af3b-b7364d7d49bc",
    "services": [
      "localhost"
    ],
    "generator": [
      {
        "filters": {
          "filters": [
            {
              "include": true,
              "detectedLocation": "/api/profile"
            },
            {
              "include": true,
              "detectedCommand": "GET"
            }
          ]
        },
        "extractor": {
          "type": "http_req_header",
          "config": {
            "name": "Authorization",
            "index": "0"
          }
        },
        "transforms": [
          {
            "type": "jwt_resign",
            "config": {
              "key": "mock-lab-demo-signing-key",
              "matchAlg": "HS256"
            }
          }
        ],
        "id": "a15e3ae0-96e5-490c-b1fe-437eebd94d99"
      }
    ]
  },
  "active": true,
  "source": "tuning"
}
