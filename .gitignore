/languages/rust/target/
# scratch proxymock writes inside the committed per-language recordings
/languages/*/proxymock/recording/.replay/
/languages/*/proxymock/recording/*/.replay/
# scratch proxymock writes into the committed root workspace
/proxymock/results/
/proxymock/recording/.replay/
/proxymock/recording/localhost/.replay/
# companion labs under labs/ -- per-lab scratch proxymock output and binaries
/labs/pyroscope/proxymock/recording/
/labs/pyroscope/proxymock/results/
/labs/pyroscope/bin/
/labs/pyroscope/.run/
/labs/pyroscope/proxymock.log
/labs/tempo/proxymock/recording/
/labs/tempo/proxymock/results/
/labs/tempo/bin/
/labs/tempo/.run/
/labs/tempo/proxymock.log
/labs/obi/bin/
/labs/obi/proxymock/
/labs/obi/proxymock.log
/labs/prometheus/proxymock/
/labs/prometheus/bin/
/labs/prometheus/proxymock.log
# agent tutorial app -- scratch proxymock workspaces, venvs and build output
/tutorial/*/proxymock/
/tutorial/*/proxymock.log
/tutorial/go/bin/
/tutorial/python/.venv/
/tutorial/java/target/
# python bytecode
__pycache__/
# build artifacts
/mock-lab
*.test
*.out
/languages/dotnet/bin/
/languages/dotnet/obj/
node_modules/
/languages/go/go
/shared/server/server
/shared/dashboard/dashboard
/languages/cpp/app

.claude/worktrees

/labs/contract-testing/proxymock/results/
/labs/contract-testing/proxymock/recording/.replay/
/labs/contract-testing/proxymock/recording/*/.replay/

# tutorial-db: its data and downloaded Postgres, and a downloaded helper binary
/tutorial/.tutorial-db/
/tutorial/tutorial-db
/tutorial/tutorial-db.exe

# credential lab: retain the fixture and ignore new captures and replay output
/labs/credentials/proxymock/recorded-*/
/labs/credentials/proxymock/results/
/labs/credentials/proxymock/.replay/
/labs/credentials/proxymock/recording/.replay/
/labs/credentials/proxymock/recording/*/.replay/
/labs/credentials/proxymock.log
